# ==============================================================================
# JD-SERVICES MANAGEMENT — CONFIGURATION DES VARIABLES D'ENVIRONNEMENT
# ==============================================================================

# Base de Données MySQL (WAMP / Production)
DATABASE_URL="mysql://root:root@localhost:3306/jd_services_management"

# Sécurité & Authentification JWT / Sessions
AUTH_SECRET="jd-services-super-secret-key-32-chars-minimum-2026-mgmt"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Fournisseur Email (Resend / Brevo / SMTP / Mock)
# Valeurs possibles : mock | resend | brevo | smtp
EMAIL_PROVIDER="mock"
EMAIL_API_KEY=""
EMAIL_FROM="contact@jd-services.fr"
EMAIL_FROM_NAME="JD-SERVICES"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# Fournisseur Stockage de Documents (Local / S3 / Supabase / Cloudflare R2)
# Valeurs possibles : local | s3 | r2
STORAGE_PROVIDER="local"
STORAGE_BUCKET="jd-services-docs"
STORAGE_REGION="eu-west-3"
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_ENDPOINT=""

# Fournisseur Signature Électronique eIDAS (Mock / Yousign / DocuSign / Universign)
# Valeurs possibles : mock | yousign | docusign | universign
SIGNATURE_PROVIDER="mock"
SIGNATURE_API_KEY=""
SIGNATURE_ENVIRONMENT="sandbox"

# Fournisseur Facturation Électronique & Réforme 2026/2027 (Mock / PDP Agréée / Peppol)
# Note : Nécessite une convention avec une Plateforme de Dématérialisation Partenaire (PDP)
EINVOICING_PROVIDER="mock"
EINVOICING_API_KEY=""
EINVOICING_ENDPOINT=""
EINVOICING_ENVIRONMENT="sandbox"
COMPANY_TAX_IDENTIFIER="FR130419377"
